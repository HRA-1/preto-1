{
    "family": "preto-streamlit-app",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::201023212334:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::201023212334:role/ecsTaskRole",
    "runtimePlatform": {
        "cpuArchitecture": "ARM64",
        "operatingSystemFamily": "LINUX"
    },
    "containerDefinitions": [
        {
            "name": "preto-streamlit-app-container",
            "image": "201023212334.dkr.ecr.ap-northeast-2.amazonaws.com/preto-streamlit-app:latest",
            "portMappings": [
                {
                    "containerPort": 8501,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/preto-streamlit-app",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "environment": [
                {
                    "name": "ENVIRONMENT",
                    "value": "prod"
                }
            ]
        }
    ]
}